				},
				"inputs": [
					{
						"referenceName": "DS_ADLS_SOURCE_CSV",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_SINK_CSV",
						"type": "DatasetReference"
					}
