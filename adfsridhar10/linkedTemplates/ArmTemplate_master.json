{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfsridhar10"
		},
		"DS_SQLSERVER_ONPREM_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'DS_SQLSERVER_ONPREM'"
		},
		"LS_ADLSGEN2_COPY_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLSGEN2_COPY'"
		},
		"LS_LOG_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_LOG'"
		},
		"LS_SQLSERVER_ONPREM_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLSERVER_ONPREM'"
		},
		"DS_SQLSERVER_ONPREM_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SRIDHAR"
		},
		"DS_SQLSERVER_ONPREM_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2022"
		},
		"DS_SQLSERVER_ONPREM_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "chetan"
		},
		"LS_ADLSGEN2_COPY_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgen2sridharstorage.dfs.core.windows.net/"
		},
		"LS_RESTAPI_SOURCE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retoolapi.dev/5yDVOt/data"
		},
		"LS_SQLSERVER_ONPREM_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SRIDHAR"
		},
		"LS_SQLSERVER_ONPREM_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2022"
		},
		"LS_SQLSERVER_ONPREM_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "chetan"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfsridhar10_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLSGEN2_COPY_accountKey": {
						"value": "[parameters('LS_ADLSGEN2_COPY_accountKey')]"
					},
					"LS_LOG_connectionString": {
						"value": "[parameters('LS_LOG_connectionString')]"
					},
					"DS_SQLSERVER_ONPREM_password": {
						"value": "[parameters('DS_SQLSERVER_ONPREM_password')]"
					},
					"LS_SQLSERVER_ONPREM_password": {
						"value": "[parameters('LS_SQLSERVER_ONPREM_password')]"
					},
					"LS_ADLSGEN2_COPY_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSGEN2_COPY_properties_typeProperties_url')]"
					},
					"LS_RESTAPI_SOURCE_properties_typeProperties_url": {
						"value": "[parameters('LS_RESTAPI_SOURCE_properties_typeProperties_url')]"
					},
					"DS_SQLSERVER_ONPREM_properties_typeProperties_server": {
						"value": "[parameters('DS_SQLSERVER_ONPREM_properties_typeProperties_server')]"
					},
					"DS_SQLSERVER_ONPREM_properties_typeProperties_database": {
						"value": "[parameters('DS_SQLSERVER_ONPREM_properties_typeProperties_database')]"
					},
					"DS_SQLSERVER_ONPREM_properties_typeProperties_userName": {
						"value": "[parameters('DS_SQLSERVER_ONPREM_properties_typeProperties_userName')]"
					},
					"LS_SQLSERVER_ONPREM_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLSERVER_ONPREM_properties_typeProperties_server')]"
					},
					"LS_SQLSERVER_ONPREM_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLSERVER_ONPREM_properties_typeProperties_database')]"
					},
					"LS_SQLSERVER_ONPREM_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLSERVER_ONPREM_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adfsridhar10_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfsridhar10_ArmTemplate_0')]"
			]
		}
	]
}